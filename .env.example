# ─── Analytics (optional) ───────────────────────────────────────────────
# Google Analytics 4 Measurement ID. Leave blank to fully disable analytics.
# Analytics NEVER loads before the visitor grants consent in the cookie banner.
VITE_GA_MEASUREMENT_ID=

# ─── Forms (contact + newsletter) ───────────────────────────────────────
# Formspree (or compatible) endpoint. Used by the contact and newsletter forms.
VITE_FORM_ENDPOINT=
VITE_NEWSLETTER_ENDPOINT=

# ─── Payments ───────────────────────────────────────────────────────────
# Publishable key ONLY (never a secret key). Safe to expose in the browser.
# Leave blank until a payment provider (e.g. Stripe) is configured on the server.
VITE_PAYMENTS_PROVIDER=
VITE_STRIPE_PUBLISHABLE_KEY=
# Base URL of your serverless/checkout backend (see /api example in README).
VITE_CHECKOUT_API_BASE=

# ─── Accounts (required for production cross-device login) ──────────────
# Add these values to every Vercel environment used by the live site.
# Use only the public anon/publishable key; never expose the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# New Supabase projects may label the same public client credential as a publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Consent-gated analytics
VITE_CLARITY_PROJECT_ID=
VITE_ANALYTICS_DEBUG=false

# Edge Function secrets (set with `supabase secrets set`; never prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=server-only
# EDGE_RATE_LIMIT_SALT=long-random-server-only-value
